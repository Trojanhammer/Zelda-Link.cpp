{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build game (debug)",
            "type": "shell",
            "command": "/usr/bin/clang++ -std=c++17 -g -O0 $(find src -name '*.cpp') -Isrc -Isrc/entities -Isrc/sdl -I/opt/homebrew/include/SDL2 -D_THREAD_SAFE -L/opt/homebrew/lib -lSDL2main -lSDL2 -lSDL2_image -lSDL2_mixer -Wl,-framework,Cocoa -o game",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
