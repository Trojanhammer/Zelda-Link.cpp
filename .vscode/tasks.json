{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build game (debug)",
            "type": "shell",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++17",
                "-g",
                "-O0",
                "main.cpp",
                "weapon.cpp",
                "Enemy.cpp",
                "Bokobolin.cpp",
                "Stalfos.cpp",
                "-o",
                "game"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
